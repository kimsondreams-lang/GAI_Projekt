<!doctype html><meta charset=utf-8><title>GAI Blog</title><body style='background:#0b0c10;color:#e6edf3;font-family:system-ui'><h1 style='padding:16px'>GAI Blog</h1><script>(function(){function post(d){navigator.sendBeacon('/api/track',new Blob([JSON.stringify(d)],{type:'application/json'}))}document.addEventListener('DOMContentLoaded',function(){post({event:'pageview',slug:(location.pathname.replace(/^\/+|\/+$/g,'')||'index')})});})();</script></body>