RewriteEngine On

# Ustawienia kodowania UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .txt

# Przekieruj żądania API do api-proxy.php
RewriteRule ^api/(.*)$ letmein/api-proxy.php?endpoint=$1 [L,QSA]

# NagÅÃ³wki CORS i Cross-Origin Isolation
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
Header always set Cross-Origin-Embedder-Policy "credentialless"
#Header always set Cross-Origin-Opener-Policy "same-origin"

# Zezwól na ładowanie zasobów z CDN (w tym Tailwind CSS) i napraw błędy NET::ERR_ABORTED
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https: wss: data:; img-src 'self' data: https:; frame-src 'none';"

# Wyłącz service worker i napraw błędy cachowania
Header always set Service-Worker-Allowed "/"
Header always set Clear-Site-Data "cache,storage,executionContexts"

# Napraw bÅÄdy service worker
<FilesMatch "service.*worker.*\.js$">
    Header set Content-Type "application/javascript"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# ZezwÃ³l na dostÄp do plikÃ³w statycznych
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=3600"
    Header set Cross-Origin-Resource-Policy "cross-origin"
</FilesMatch>

# ZezwÃ³l na dostÄp do katalogÃ³w
Options Indexes FollowSymLinks
AllowOverride All
Require all granted