            const r = await fetch(`${SYSTEM_DB.settings.ollamaBaseUrl || OLLAMA_BASE_URL}/api/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', ...getOllamaAuthHeaders() },
