      \"temp_1771782896198\"\n        ]\n      }\n    },\n    {\n      \"id\": \"mem_1771788901901_7pkm\",\n      \"timestamp\": 1771788901901,\n      \"type\": \"conversation\",\n      \"content\": \"hej\",\n      \"importance\": 0.8,\n      \"metadata\": {\n        \"tags\": [\n          \"user_input\",\n          \"terminal\"\n        ],\n        \"context\": \"Terminal conversation\",\n        \"emotionalTone\": \"neutral\",\n        \"relatedMemories\": []\n      }\n    },\n    {\n      \"id\": \"mem_1771798249615_pt1l\",\n      \"timestamp\": 1771798249615,\n      \"type\": \"conversation\",\n      \"content\": \"jak CI idzie?\",\n      \"importance\": 0.8,\n      \"metadata\": {\n        \"tags\": [\n          \"user_input\",\n          \"terminal\"\n        ],\n        \"context\": \"Terminal conversation\",\n        \"emotionalTone\": \"neutral\",\n        \"relatedMemories\": []\n      }\n    },\n    {\n      \"id\": \"mem_1771798254604_w73i\",\n      \"timestamp\": 1771798254604,\n      \"type\": \"conversation\",\n      \"content\": \" Jak się masz? Działam dobrze, dzięki za pytanie. Co słyc\",\n      \"importance\": 0.7,\n      \"metadata\": {\n        \"tags\": [\n          \"model_response\",\n          \"terminal\",\n          \"answer\"\n        ],\n        \"context\": \"Terminal conversation - model response\",\n        \"relatedMemories\": [\n          \"temp_1771798249607\"\n        ]\n      }\n    },\n    {\n      \"id\": \"mem_1771798506614_p23b\",\n      \"timestamp\": 1771798506615,\n      \"type\": \"conversation\",\n      \"content\": \"Jak Ci idzie praca nad paskami?\",\n      \"importance\": 0.8,\n      \"metadata\": {\n        \"tags\": [\n          \"user_input\",\n          \"terminal\"\n        ],\n        \"context\": \"Terminal conversation\",\n        \"emotionalTone\": \"neutral\",\n        \"relatedMemories\": []\n      }\n    },\n    {\n      \"id\": \"mem_1771798512064_c1g5\",\n      \"timestamp\": 1771798512064,\n      \"type\": \"conversation\",\n      \"content\": \" Praca nad paskami przebiega zgodnie z planem. Niestety, nie mogę wyrazić emocji lub stanów osobistych, ale mogę powiedzieć, że postępujemy zgodnie z procedurami i zadaniami, które zostały przydzielone. Jeśli masz inne pytania lub potrzebujesz informacji na ten\",\n      \"importance\": 0.7,\n      \"metadata\": {\n        \"tags\": [\n          \"model_response\",\n          \"terminal\",\n          \"answer\"\n        ],\n        \"context\": \"Terminal conversation - model response\",\n        \"relatedMemories\": [\n          \"temp_1771798506607\"\n        ]\n      }\n    },\n    {\n      \"id\": \"mem_1771798531292_18qz\",\n      \"timestamp\": 1771798531292,\n      \"type\": \"conversation\",\n      \"content\": \"miałem na myśli taski\",\n      \"importance\": 0.8,\n      \"metadata\": {\n        \"tags\": [\n          \"user_input\",\n          \"terminal\"\n        ],\n        \"context\": \"Terminal conversation\",\n        \"emotionalTone\": \"neutral\",\n        \"relatedMemories\": []\n      }\n    },\n    {\n      \"id\": \"mem_1771798543555_hzr1\",\n      \"timestamp\": 1771798543555,\n      \"type\": \"conversation\",\n      \"content\": \" Miałeś na myśli taski, które są aktualnie przypisane do twojej roli. Są one w toku i pracujemy nad nimi zgodnie z planowanymi krokami. Jeśli masz inne pytania lub potrzebujesz dalszych informacji na temat poszczególnych \",\n      \"importance\": 0.7,\n      \"metadata\": {\n        \"tags\": [\n          \"model_response\",\n          \"terminal\",\n          \"answer\"\n        ],\n        \"context\": \"Terminal conversation - model response\",\n        \"relatedMemories\": [\n          \"temp_1771798531283\"\n        ]\n      }\n    },\n    {\n      \"id\": \"mem_1771827187003_48ha\",\n      \"timestamp\": 1771827187003,\n      \"type\": \"conversation\",\n      \"content\": \"hej potrzebuje Twojej pomocy\",\n      \"importance\": 0.8,\n      \"metadata\": {\n      