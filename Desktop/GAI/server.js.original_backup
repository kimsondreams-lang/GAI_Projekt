const validateOllamaModelRef = (name) => {
    if (typeof name !== 'string') return false;
    const trimmed = name.trim();
    if (!trimmed || trimmed.length > 200) return false;
    return /^[a-zA-Z0-9._/-]+(:[a-zA-Z0-9._-]+)?$/.test(trimmed);
};

