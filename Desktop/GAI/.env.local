# GAI OS Environment Configuration
# This file contains environment variables for the GAI Operating System
# Copy this to .env.local and update with your actual values

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Primary AI Provider (currently only 'ollama' is supported)
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=1800000  # 30 minutes in milliseconds
OLLAMA_DEFAULT_MODEL=llama3.1

# =============================================================================
# TELEGRAM INTEGRATION (Optional)
# =============================================================================

# Telegram Bot Configuration
# To enable Telegram integration:
# 1. Create a bot via @BotFather on Telegram
# 2. Copy the bot token and paste below
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID (optional - can be auto-configured)
# TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session Security
SESSION_SECRET=your-super-secure-session-secret-key-min-32-chars
JWT_SECRET=your-256-bit-secret-for-jwt-authentication-layer-gai-os

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000  # Max requests per window
RATE_LIMIT_STRICT_MAX=100  # Max requests for sensitive operations

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Server Configuration
PORT=1234
NODE_ENV=development

# Debug Mode (true/false)
DEBUG_MODE=true
VERBOSE_LOGGING=true

# File System Configuration
MAX_FILE_SIZE_MB=50  # Maximum file size for uploads in MB
ALLOWED_FILE_EXTENSIONS=.txt,.md,.json,.js,.ts,.py,.html,.css

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
MAX_BACKUPS=10

# =============================================================================
# EXTERNAL API KEYS (Optional)
# =============================================================================

# Gemini API (for future use)
GEMINI_API_KEY=PLACEHOLDER_API_KEY

# OpenAI API (for future use)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for future use)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# MONITORING & HEALTH
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=30000  # 30 seconds

# Error Reporting
ERROR_REPORTING_ENABLED=true
ERROR_REPORTING_LEVEL=error  # error, warn, info, debug

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 
# 1. SECURITY: Never commit real API keys to version control
# 2. BACKUP: Regularly backup your .env.local file
# 3. VALIDATION: All values are validated on startup
# 4. DOCS: See README.md for detailed configuration guide
#
# For production deployment:
# - Use strong, unique secrets
# - Enable all security features
# - Set up proper monitoring
# - Configure backup strategies

FTP_HOST=89.116.53.41
FTP_USER=u866168581.coolkee.fun
