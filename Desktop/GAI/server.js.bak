        telegramConfig: { botToken: '', chatId: '', enabled: false },
        taskbarOpacity: 0.8,
        iconSize: 'medium',
        autonomousObjectives: '',
        autorecovery: {
            enabled: true,
            modelRole: 'planning',
            prompt: '',
            autoOnBoot: true,
