      "text": "Executing [TOOL] {\"name\": \"PYTHON_EXEC\", \"arguments\": {\"code\": \"import os, json, re\\n\\ndef fix_article(path):\\n    with open(path, 'r', encoding='utf-8') as f:\\n        content = f.read()\\n    \\n    # Fix missing quote: tag=kimsondreams-21 target= -> tag=kimsondreams-21' target=\\n    content = content.replace(\\\"tag=kimsondreams-21 target=\\\", \\\"tag=kimsondreams-21' target=\\\")\\n    \\n    # Fix concatenated URLs: /s?k=.../dp/ASIN -> /dp/ASIN\\n    content = re.sub(r'https://www\\\\.amazon\\\\.com/s\\\\?k=[^/\\\"\\\\']+/dp/([A-Z0-9]{10})', r'https://www.amazon.com/dp/\\\\1', content)\\n    \\n    # Fix future dates\\n    content = content.replace('\\\"date\\\": \\\"2026-', '\\\"date\\\": \\\"2025-')\\n    \\n    with open(path, 'w', encoding='utf-8') as f:\\n        f.write(content)\\n\\narticles_dir = '/Users/jakubnetza/Desktop/GAI/data/articles'\\nfor fn in os.listdir(articles_dir):\\n    if fn.endswith('.json') and fn != 'index.json':\\n        fix_article(os.path.join(articles_dir, fn))\\nprint('Articles fixed.')\"}}}",
