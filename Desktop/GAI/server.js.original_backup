const maybeCreateTaskFromUserMessage = async (message, source = 'terminal') => {
    const text = String(message || '').trim();
    if (!text) return false;
    const hasOpenTasks = SYSTEM_DB.tasks.some(t => t.status !== 'completed');
    if (hasOpenTasks) return false;
    const looksLikeTask = isTaskIntentMessage(text);
    if (!looksLikeTask) return false;
    const title = text.length > 90 ? `${text.slice(0, 87)}...` : text;
    const duplicate = SYSTEM_DB.tasks.slice(-3).some(t => t.title === title || t.description === text);
    if (duplicate) return false;
    const created = normalizeTask({
        id: `task_${Date.now()}`,
        title,
        description: text,
        status: 'pending',
        progress: 0,
        priority: 'high',
        logs: [`[AUTO/${source}] Task created from user request.`],
        createdAt: Date.now(),
        updatedAt: Date.now()
    });
    SYSTEM_DB.tasks.push(created);
    const breakdownCfg = getTaskBreakdownConfig();
    if (breakdownCfg.enabled && breakdownCfg.autoOnCreate) {
        await generateTaskBreakdownForTask(created, source);
    }
    saveState();
    logToChat('system', `[TASK] Auto-created: ${title}`, 'system');
    return true;
};

