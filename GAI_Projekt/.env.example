# =============================================================================
# GAI AGENT - ENVIRONMENT VARIABLES
# =============================================================================

# 🔐 SECURITY & AUTHENTICATION
# =============================================================================
GAI_PANEL_PASSWORD=your_secure_password_here
NEXT_PUBLIC_GAI_PANEL_PASSWORD=your_secure_password_here

# 🗄️ DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/gai_db
POSTGRES_USER=gai
POSTGRES_PASSWORD=gai_secure_password
POSTGRES_DB=gai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 📊 REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 🤖 AI MODEL PROVIDERS
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id_here

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# DeepSeek Configuration
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 🌐 FTP PUBLISHING CONFIGURATION
# =============================================================================
FTP_HOST=your_ftp_host_here
FTP_USER=your_ftp_username_here
FTP_PASS=your_ftp_password_here
FTP_BASE_DIR=/public_html/content
FTP_PORT=21
FTP_SECURE=true

# 📈 ANALYTICS & TRACKING
# =============================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token_here
ANALYTICS_TRACKING_ENABLED=true

# ⚙️ SYSTEM CONFIGURATION
# =============================================================================
# Agent Configuration
WAKE_CYCLE_MIN=5
COST_BUDGET_USD_PER_CYCLE=5.0
MAX_TASKS_PER_CYCLE=10
REQUIRE_APPROVAL_FOR_NEW_CATEGORIES=false

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_super_secret_key_here_min_32_chars
ALLOWED_HOSTS=localhost,127.0.0.1,your_domain.com
CORS_ORIGINS=http://localhost:3000,https://your_domain.com

# 📡 BACKEND CONFIGURATION
# =============================================================================
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# 🌐 FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
WS_URL=ws://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# 🔧 DEVELOPMENT CONFIGURATION
# =============================================================================
# Development overrides (use only in dev)
# DEBUG=true
# LOG_LEVEL=DEBUG
# ENVIRONMENT=development
# DISABLE_AUTHENTICATION=false
# MOCK_EXTERNAL_SERVICES=false

# 📋 OPTIONAL INTEGRATIONS
# =============================================================================
# Amazon Affiliate
AMAZON_API_KEY=your_amazon_api_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_ASSOCIATE_TAG=your_associate_tag_here

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ADMIN_EMAIL=admin@your_domain.com

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# RAILWAY-SPECIFIC CONFIGURATION
# =============================================================================
# Railway automatically sets these:
# RAILWAY_PROJECT_ID=your_railway_project_id
# RAILWAY_SERVICE_ID=your_railway_service_id
# RAILWAY_ENVIRONMENT=production
# RAILWAY_DOMAIN=your-app.railway.app
# PORT=8000 (Railway sets this automatically)

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# For local development with docker-compose:
# COMPOSE_PROJECT_NAME=gai-agent
# COMPOSE_FILE=deploy/docker-compose.yml